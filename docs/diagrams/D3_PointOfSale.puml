@startuml BB_D3_PointOfSale
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title D3 - Point of Sale (UC18-UC29, UC46)

actor "Cashier" as CAS
actor "Manager" as MGR
actor "VietQR" as VQR <<external>>

rectangle "BrewBoss" {
  rectangle " " <<inner>> {
    usecase "UC18\nManage tables & QR" as UC18
    usecase "UC19\nView table map" as UC19
    usecase "UC20\nCreate order" as UC20
    usecase "UC21\nEdit order items" as UC21
    usecase "UC23\nMark order served" as UC23
    usecase "UC26\nMove / merge table" as UC26
    together {
      usecase "UC22\nConfirm customer order" as UC22
      usecase "UC27\nCancel order" as UC27
    }
    together {
      usecase "UC24\nApply voucher" as UC24
      usecase "UC25\nTake payment" as UC25
      usecase "UC28\nView & share receipt" as UC28
    }
    usecase "UC29\nConfigure shop settings" as UC29
    usecase "UC46\nSplit payment" as UC46
    usecase "UC10\nBrowse & search menu\n(see D2)" as UC10
  }
}

CAS -- UC19
CAS -- UC20
CAS -- UC21
CAS -- UC23
CAS -- UC26
CAS -- UC22
CAS -- UC27
CAS -- UC24
CAS -- UC25
CAS -- UC28

MGR -- UC18
MGR -- UC29

UC20 ..> UC10 : <<include>>
UC24 .[norank].> UC25 : <<extend>>
UC28 .[norank].> UC25 : <<extend>>
UC25 <.. UC46 : <<extend>>
UC27 .[norank].> UC22 : <<extend>>
UC25 -- VQR

@enduml
