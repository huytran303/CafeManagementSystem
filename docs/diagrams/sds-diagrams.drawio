Cell><mxCell id="c23" value="GET QR image (amount, shortId)" style="fontFamily=Helvetica;fontSize=12;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="60"/><mxPoint x="420" y="-10"/><mxPoint x="1310" y="-10"/></Array></mxGeometry></mxCell><mxCell id="c24" value="scan" style="fontFamily=Helvetica;fontSize=12;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="02 Layered Architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Layered architecture of the Flutter app&lt;/b&gt;" style="fontFamily=Helvetica;fontSize=12;text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="-110" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Presentation layer — features/*/presentation&lt;/b&gt;&lt;br&gt;Screens and widgets (ConsumerWidget). ref.watch providers in build, ref.read controllers in callbacks. AsyncValue.when for loading / error / empty. Navigation with context.push(Routes.x)." style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="640" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Application layer — features/*/application&lt;/b&gt;&lt;br&gt;Riverpod providers (StreamProvider, Provider), AsyncNotifier controllers (writes, AsyncValue.guard, return bool) and &amp;lt;module&amp;gt;_rules.dart pure business rules." style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="640" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Data layer — features/*/data&lt;/b&gt;&lt;br&gt;Repositories: the only classes that call Firebase. Map documents ↔ freezed models; run Firestore transactions." style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="260" width="640" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Firebase SDKs&lt;/b&gt;&lt;br&gt;firebase_auth, cloud_firestore, firebase_storage, firebase_messaging" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="640" height="90" as="geometry"/></mxCell><mxCell id="c7" value="depends on" style="fontFamily=Helvetica;fontSize=12;html=1;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="depends on" style="fontFamily=Helvetica;fontSize=12;html=1;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="depends on" style="fontFamily=Helvetica;fontSize=12;html=1;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;core/&lt;/b&gt;&lt;br&gt;router (GoRouter + role guard)&lt;br&gt;theme&lt;br&gt;utils (formatVnd, TimestampConverter, validators)&lt;br&gt;widgets (LoadingView, ErrorView, EmptyView)" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="0" width="220" height="220" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;mo