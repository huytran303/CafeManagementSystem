<mxfile host="app.diagrams.net" type="device"><diagram id="state" name="Order State Machine"><mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st0" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="20" height="20" as="geometry"/></mxCell><mxCell id="pending" value="pending" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="120" height="50" as="geometry"/></mxCell><mxCell id="preparing" value="preparing" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="260" width="120" height="50" as="geometry"/></mxCell><mxCell id="ready" value="ready" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="120" height="50" as="geometry"/></mxCell><mxCell id="served" value="served" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="540" width="120" height="50" as="geometry"/></mxCell><mxCell id="paid" value="paid" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="680" width="120" height="50" as="geometry"/></mxCell><mxCell id="end_paid" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="250" y="790" width="20" height="20" as="geometry"/></mxCell><mxCell id="cancelled" value="cancelled" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="120" height="50" as="geometry"/></mxCell><mxCell id="end_cancel" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="720" y="345" width="20" height="20" as="geometry"/></mxCell><mxCell id="s1" value="staff creates order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st0" target="pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="Barista starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending" target="preparing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="Barista finishes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="preparing" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="Cashier serves / hands over takeaway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready" target="served"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="payment confirmed (only from served, BR-PAY-04): deduct stock, add points" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="served" target="paid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="paid" target="end_paid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="Cashier / Manager cancels (reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pending" target="cancelled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="Manager cancels (reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="preparing" target="cancelled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="items added (BR-ORD-04)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="served" target="pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="565"/><mxPoint x="60" y="145"/></Array></mxGeometry></mxCell><mxCell id="s10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="cancelled" target="end_cancel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note2" value="awaiting: customer QR order, hidden from the barista&lt;br&gt;and not occupying the table until confirmed; if the table&lt;br&gt;has an open order, confirming adds the items to it (BR-ORD-07).&lt;br&gt;Terminal states: paid, cancelled (no edits).&lt;br&gt;Payment only from served, dine-in and takeaway alike;&lt;br&gt;there is no pay-first flow (BR-PAY-04).&lt;br&gt;Items may be added while pending / preparing (same batch)&lt;br&gt;or ready / served (new batch, back to pending);&lt;br&gt;existing lines are editable only while pending (BR-ORD-04).&lt;br&gt;Stock is deducted at payment, not at creation (BR-INV-01).&lt;br&gt;Cancel from preparing / ready / served: if the drinks&lt;br&gt;were already made, stock is deducted as waste (BR-INV-02)." style="shape=note;size=12;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="630" width="320" height="190" as="geometry"/></mxCell><mxCell id="s12" value="Manager cancels (reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="cancelled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s13" value="Manager cancels (reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="served" target="cancelled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="st1" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="45" width="20" height="20" as="geometry"/></mxCell><mxCell id="awaiting" value="awaiting" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="120" height="50" as="geometry"/></mxCell><mxCell id="s14" value="customer orders via QR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st1" target="awaiting"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s15" value="Cashier confirms (FR-CUS-05)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="awaiting" target="pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="55"/><mxPoint x="420" y="132"/></Array></mxGeometry></mxCell><mxCell id="s16" value="Cashier rejects (reason)&lt;br&gt;or items added to the open order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="awaiting" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="68"/><mxPoint x="680" y="300"/><mxPoint x="610" y="300"/></Array></mxGeometry></mxCell><mxCell id="s17" value="items added (BR-ORD-04)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="425"/><mxPoint x="120" y="157"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>