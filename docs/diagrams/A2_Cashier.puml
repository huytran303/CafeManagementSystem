@startuml BB_A2_Cashier
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title A2 - Cashier
actor "Cashier" as CAS
actor "VietQR" as VQR <<external>>
actor "Firebase Cloud Messaging" as FCM <<external>>

rectangle "BrewBoss" {
  rectangle " " <<inner>> {
    usecase "UC19\nView table map" as UC19
    usecase "UC20\nCreate order" as UC20
    usecase "UC21\nEdit order items" as UC21
    usecase "UC26\nMove / merge table" as UC26
    usecase "UC23\nMark order served" as UC23
    usecase "UC09\nToggle availability" as UC09
    together {
      usecase "UC22\nConfirm customer order" as UC22
      usecase "UC27\nCancel order" as UC27
    }
    usecase "UC25\nTake payment" as UC25
    usecase "UC24\nApply discount" as UC24
    usecase "UC38\nAttach loyalty customer" as UC38
    usecase "UC39\nRedeem points" as UC39
    usecase "UC28\nView & share receipt" as UC28
    usecase "UC10\nBrowse & search menu\n(see A1)" as UC10
    usecase "UC15\nDeduct stock by recipe" as UC15
    usecase "UC16\nSend low-stock alert" as UC16
    usecase "UC43\nDeduct cancel waste" as UC43
  }
}

CAS -- UC19
CAS -- UC20
CAS -- UC21
CAS -- UC26
CAS -- UC23
CAS -- UC09
CAS -- UC22
CAS -- UC27
CAS -- UC25

UC20 ..> UC10 : <<include>>
UC27 .[norank].> UC22 : <<extend>>
UC27 <.. UC43 : <<extend>>
UC25 <.. UC24 : <<extend>>
UC25 <.. UC38 : <<extend>>
UC25 <.. UC39 : <<extend>>
UC25 <.. UC28 : <<extend>>
UC25 ..> UC15 : <<include>>
UC15 <.. UC16 : <<extend>>

UC25 -- VQR
UC16 -- FCM
@enduml
