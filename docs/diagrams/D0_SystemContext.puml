@startuml BB_D0_SystemContext
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
' inner frame: invisible, only adds padding inside the system boundary
skinparam rectangle<<inner>> {
  BorderColor Transparent
  FontColor Transparent
}
hide <<inner>> stereotype

title BrewBoss - System Context

actor "Staff" as A_STAFF
actor "Customer" as A_CUS
actor "Cashier" as A_CAS
actor "Barista" as A_BAR
actor "Manager" as A_MGR
actor "Firebase Auth" as A_FAUTH <<external>>
actor "VietQR" as A_VQR <<external>>
actor "Firebase Cloud Messaging" as A_FCM <<external>>

rectangle "BrewBoss" {
  rectangle " " <<inner>> {
    package "Authentication" as AUTH
    package "Staff Management" as STAFF
    package "Menu" as MENU
    package "Customer Ordering" as CUS
    package "Point of Sale" as POS
    package "Loyalty" as LOY
    package "Barista Display" as BAR
    package "Inventory" as INV
    package "Reports" as RPT
  }
}

A_STAFF -- AUTH
A_STAFF -- STAFF
A_STAFF -- MENU
A_CUS -- MENU
A_CUS -- CUS
A_CAS -- POS
A_CAS -- LOY
A_BAR -- BAR

AUTH -- A_MGR
STAFF -- A_MGR
MENU -- A_MGR
POS -- A_MGR
LOY -- A_MGR
INV -- A_MGR
RPT -- A_MGR

AUTH -- A_FAUTH
CUS -- A_FAUTH
POS -- A_VQR
INV -- A_FCM
BAR -- A_FCM
@enduml
